[click_next]
[hide_message_window]
[hide name="moe" mode="def" time="600" wait="true"]
[chara_part name="miyu" face="embarrass"]
[app name="miyu" pos="3" time="600" wait="true"]
[talk name="miyu" face="embarrass"]
……嗯……
[click_next]
[chara_part name="miyu" face="depressed"]
[talk name="miyu" face="depressed"]
